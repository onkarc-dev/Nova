# Nova environment template
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"
TRUST_PROXY=false
LOG_LEVEL=info
DATABASE_URL="postgresql://nova:nova@localhost:5433/nova?schema=public"
DIRECT_URL="postgresql://nova:nova@localhost:5433/nova?schema=public"
JWT_ACCESS_SECRET="replace-with-a-strong-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-strong-refresh-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
REDIS_URL="redis://localhost:6379"
EMAIL_FROM="no-reply@nova.local"
SMTP_URL="smtp://user:password@localhost:1025"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STORAGE_PROVIDER="local"
STORAGE_BUCKET="nova-assets"
CLOUDINARY_URL=""
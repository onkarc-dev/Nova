# Nova required runtime environment variables
# Copy this file to .env for local development and replace all placeholder secrets.

APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
DATABASE_URL="postgresql://nova:nova@localhost:5433/nova?schema=public"
DIRECT_URL="postgresql://nova:nova@localhost:5433/nova?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-strong-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-strong-refresh-secret-at-least-32-characters"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""
MEILISEARCH_INDEX_PRODUCTS="products"
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@cadde.local"
